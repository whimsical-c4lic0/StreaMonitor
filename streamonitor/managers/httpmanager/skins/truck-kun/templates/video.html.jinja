<video controls preload="metadata" playsinline aria-label="{{ video_to_play.filename }}"><source src="{{ url_for('get_video', user=user, site=site, filename=video_to_play.filename) }}" type="{{ video_to_play.mimetype }}">Your browser cannot play this recording. Use the download link below.</video>
<div class="player-toolbar"><div class="player-filename"><span class="muted">Now playing</span><h2>{{ video_to_play.filename }}</h2></div><div class="player-actions"><a class="button" href="{{ url_for('get_video', user=user, site=site, filename=video_to_play.filename) }}" download>Download <i class="icon feather icon-download" aria-hidden="true"></i></a><button type="button" data-action="theater" aria-pressed="{{ 'true' if theater_mode else 'false' }}" aria-label="Toggle expanded player"><i class="icon feather icon-maximize" aria-hidden="true"></i></button></div></div>
<input type="hidden" name="play_video" class="streamer-context play-video-context" value="{{ video_to_play.filename }}">
