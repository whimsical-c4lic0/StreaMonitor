{% extends "layout.html.jinja" %}
{% block title %}Streamers · StreaMonitor{% endblock %}
{% block content %}
    <div class="page-heading"><div><h1>Streamers</h1><p class="muted">Manage monitoring and recordings</p></div><button class="primary" type="button" data-action="open-add">+ Add streamer</button></div>
    {% include 'summary.html.jinja' %}
    <section class="list-panel" aria-label="Monitored streamers">
        <form id="filter-streamers" class="filters" autocomplete="off" hx-get="/refresh/streamers" hx-target="#streamers" hx-swap="innerHTML" hx-sync="#streamers:queue last" hx-trigger="submit, input delay:350ms" hx-vals='{"set_filters":"True"}' hx-include=".filter-streamers-state">
            <label class="search-field"><span class="sr-only">Search streamers by username</span><i class="icon feather icon-search" aria-hidden="true"></i><input type="search" name="filter-username" id="filter-username" class="filter-streamers-state" placeholder="Search streamers…" value="{{ username_filter or '' }}"></label>
            <label><span class="sr-only">Filter by site</span><select name="filter-site" id="filter-site" class="filter-streamers-state">{% include 'filter_site_options.html.jinja' %}</select></label>
            <label><span class="sr-only">Filter by status</span><select name="filter-status" id="filter-status" class="filter-streamers-state">
                <option value="all" {{ 'selected' if not status_filter or status_filter == 'all' }}>All statuses</option>
                <option value="running" {{ 'selected' if status_filter == 'running' }}>Monitored</option><option value="rec" {{ 'selected' if status_filter == 'rec' }}>Recording</option>
                {% for status, label in streamer_statuses.items() %}<option value="{{ status.value }}" {{ 'selected' if status_filter == status.value|string }}>{{ label.split(',')[0] }}</option>{% endfor %}
            </select></label>
            <button type="button" class="quiet" data-action="reset-filters">Reset</button>
        </form>
        <div class="list-tools"><details class="list-options"><summary>List options</summary><div class="options-popover">
            <label>Sort by<select id="sort_by" name="sort_by" class="filter-streamers-state" hx-get="/refresh/streamers" hx-trigger="change" hx-include=".filter-streamers-state" hx-target="#streamers" hx-sync="#streamers:queue last">
                {% for key, label in [('username','Username'),('site','Site'),('running','Monitoring'),('status','Status'),('last_stream','Last stream'),('video_files_total_size','Storage'),('video_files_count','Recording count')] %}<option value="{{ key }}" {{ 'selected' if sort_by == key }}>{{ label }}</option>{% endfor %}
            </select></label>
            <label>Order<select id="sort_dir" name="sort_dir" class="filter-streamers-state" hx-get="/refresh/streamers" hx-trigger="change" hx-include=".filter-streamers-state" hx-target="#streamers" hx-sync="#streamers:queue last"><option value="asc" {{ 'selected' if sort_dir != 'desc' }}>Ascending</option><option value="desc" {{ 'selected' if sort_dir == 'desc' }}>Descending</option></select></label>
            <button type="button" hx-patch="/start/streamers" hx-target="#streamers" hx-include=".filter-streamers-state" hx-disabled-elt="this" hx-sync="#streamers:queue last">Resume all shown</button>
            <button type="button" hx-patch="/stop/streamers" hx-target="#streamers" hx-include=".filter-streamers-state" hx-disabled-elt="this" hx-sync="#streamers:queue last">Pause all shown</button>
        </div></details><span class="muted">Select a streamer to view recordings</span></div>
        <div id="error-container" role="alert"></div>
        {% set initial_render = true %}{% set toast_status = 'hide' %}
        <div id="streamers" {% if refresh_freq and refresh_freq > 0 %}hx-get="/refresh/streamers" hx-trigger="every {{ refresh_freq }}s, refresh" hx-target="this" hx-swap="innerHTML" hx-sync="#streamers:queue last" hx-include=".filter-streamers-state"{% else %}hx-get="/refresh/streamers" hx-trigger="refresh" hx-target="this" hx-sync="#streamers:queue last" hx-include=".filter-streamers-state"{% endif %}>
            {% include 'streamers_result.html.jinja' %}
        </div>
    </section>
    <dialog id="add-dialog" class="add-drawer" aria-labelledby="add-title">
        <form id="add-streamer-form" hx-post="/add" hx-target="#streamers" hx-swap="innerHTML" hx-include=".filter-streamers-state" hx-sync="#streamers:queue last" hx-disabled-elt="find button[type='submit']">
            <div class="drawer-heading"><h2 id="add-title">Add streamer</h2><button type="button" class="icon-button" data-action="close-add" aria-label="Close add streamer">×</button></div>
            <div class="drawer-fields"><p class="muted">Save a streamer and choose when to start monitoring.</p>
                <label for="site">Site</label><select name="site" id="site" required autofocus>{% for site in sites %}<option value="{{ site }}">{{ site }}</option>{% endfor %}</select>
                <label for="username">Username</label><input id="username" class="input-username" type="text" name="username" minlength="3" required autocomplete="off" spellcheck="false" aria-describedby="username-help">
                <p id="username-help" class="field-help">Enter the username from the room URL, not the full URL. Match the site's spelling and capitalization.</p>
                <label class="checkbox-label"><input type="checkbox" name="start_monitoring" value="1" checked> Start monitoring immediately</label>
                <p id="add-error" class="form-error" role="alert" hidden></p>
            </div>
            <div class="drawer-footer"><button type="button" data-action="close-add">Cancel</button><button type="submit" class="primary">Add streamer</button></div>
        </form>
    </dialog>
{% endblock %}
