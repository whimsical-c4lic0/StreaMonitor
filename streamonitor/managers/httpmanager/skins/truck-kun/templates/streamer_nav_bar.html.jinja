<section id="nav-bar" class="recording-heading" data-free-space="{{ ui_free_space }}" data-total-space="{{ ui_total_space }}" {% if refresh_freq and refresh_freq > 0 %}hx-get="{{ url_for('get_streamer_navbar', user=streamer.username, site=streamer.site) }}" hx-trigger="every {{ refresh_freq }}s, refresh"{% else %}hx-get="{{ url_for('get_streamer_navbar', user=streamer.username, site=streamer.site) }}" hx-trigger="refresh"{% endif %} hx-swap="outerHTML" hx-sync="#video-list:queue last" hx-include=".streamer-context">
    <a class="back-link" href="/">← All streamers</a>
    <div class="page-heading"><div><h1>{{ streamer.username }}</h1><p class="muted"><a href="{{ streamer.url }}" target="_blank" rel="noopener noreferrer">{{ streamer.site }} ↗</a><span class="heading-status">{{ 'Recording' if streamer.recording else ('Paused' if not streamer.running else streamer.sc|status_text) }}</span></p></div>
    {% include 'streamer_toggle.html.jinja' %}</div>
    <input type="hidden" name="prev_state" class="streamer-context" value="{{ streamer.sc.value }}">
</section>
{% if update_content %}<div hx-swap-oob="innerHTML:#video-list">{% include 'video_list.html.jinja' %}</div>{% endif %}
