<div class="streamer-results" data-free-space="{{ ui_free_space }}" data-total-space="{{ ui_total_space }}">
<table class="streamers-list"><thead><tr><th scope="col">Streamer</th><th scope="col">Status</th><th scope="col" class="desktop-detail">Last stream</th><th scope="col" class="desktop-detail">Storage</th><th scope="col">Monitoring</th><th scope="col"><span class="sr-only">More actions</span></th></tr></thead><tbody>
{% for streamer in streamers %}{% set streamer_has_error = false %}{% include 'streamer_record.html.jinja' %}
{% else %}<tr><td colspan="6"><div class="empty-state"><h2>{{ 'No matching streamers' if is_filtered else 'No streamers yet' }}</h2><p class="muted">{{ 'Try a different search or reset your filters.' if is_filtered else 'Add a streamer to start monitoring and saving recordings.' }}</p><button type="button" data-action="{{ 'reset-filters' if is_filtered else 'open-add' }}">{{ 'Reset filters' if is_filtered else '+ Add streamer' }}</button></div></td></tr>{% endfor %}
</tbody></table></div>
{% if not initial_render|default(false) %}{% set initial_render = false %}{% include 'summary.html.jinja' %}{% endif %}
{% if toast_status|default('hide') != 'hide' %}<div id="toast-notifications" hx-swap-oob="true" role="status"><div class="toast {{ toast_status }}">{{ toast_message }}{% if error_message %}<p>{{ error_message }}</p>{% endif %}</div></div>{% endif %}
{% if update_filter_site_options %}<select hx-swap-oob="innerHTML:#filter-site">{% include 'filter_site_options.html.jinja' %}</select>{% endif %}
