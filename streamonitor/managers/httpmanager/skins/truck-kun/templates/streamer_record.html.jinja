{% if streamer is not none %}
<tr id="streamer-{{ streamer.siteslug|lower }}-{{ streamer.username }}" class="streamer">
    <td class="streamer-identity"><a class="streamer-name" href="{{ url_for('recordings', user=streamer.username, site=streamer.site) }}">{{ streamer.username }}</a><div class="streamer-meta"><span>{{ streamer.site }}</span><span>·</span><span>{{ streamer.video_files|count }} recordings</span></div></td>
    <td class="streamer-status"><span class="status-pill {{ 'is-recording' if streamer.recording }}">{% if streamer.recording %}<span class="status-dot" aria-hidden="true"></span>Recording{% elif not streamer.running %}Paused{% else %}{{ streamer.sc|status_text }}{% endif %}</span></td>
    <td class="desktop-detail muted" title="{{ streamer.last_stream|abstime }}">{{ streamer.last_stream|reltime }}</td>
    <td class="desktop-detail muted">{{ streamer.video_files_total_size|tohumanfilesize }}</td>
    <td class="streamer-monitor"><button type="button" hx-patch="{{ url_for('toggle_streamer', user=streamer.username, site=streamer.site) }}" hx-target="closest .streamer" hx-sync="#streamers:queue last" hx-swap="outerHTML" hx-disabled-elt="this" aria-label="{{ 'Pause' if streamer.running else 'Resume' }} monitoring {{ streamer.username }}">{{ 'Pause' if streamer.running else 'Resume' }}</button></td>
    <td class="streamer-more"><details><summary class="icon-button" aria-label="More actions for {{ streamer.username }}">···</summary><div class="options-popover">
        <a href="{{ streamer.url }}" target="_blank" rel="noopener noreferrer">Open room ↗</a>
        <span class="muted">{{ streamer.country_data.flag }} {{ streamer.country_data.name }} · {{ streamer.gender_data.name }}</span>
        <span class="muted">Last stream: {{ streamer.last_stream|reltime }}</span><span class="muted">{{ streamer.video_files_total_size|tohumanfilesize }} saved</span>
        <button type="button" hx-get="{{ url_for('get_streamer_info', user=streamer.username, site=streamer.site) }}" hx-target="closest .streamer" hx-swap="outerHTML" hx-sync="#streamers:queue last" hx-disabled-elt="this">Refresh streamer</button>
        <button type="button" class="danger-text" hx-delete="{{ url_for('remove_streamer', user=streamer.username, site=streamer.site) }}" hx-target="closest .streamer" hx-swap="outerHTML" hx-sync="#streamers:queue last" hx-confirm="Remove {{ streamer.username }} from monitoring? Saved recordings will not be deleted." hx-disabled-elt="this">Remove streamer</button>
    </div></details></td>
</tr>
{% endif %}
{% if streamer_has_error %}<div id="error-container" hx-swap-oob="true" role="alert"><div class="error-modal"><span>{{ streamer_error_message }}</span><button type="button" data-action="dismiss-error">Dismiss</button></div></div>{% endif %}
