<button id="toggle-streamer" type="button" hx-patch="{{ url_for('toggle_streamer_recording_page', user=streamer.username, site=streamer.site) }}" hx-target="this" hx-swap="outerHTML" hx-sync="#video-list:queue last" hx-disabled-elt="this">{{ 'Pause' if streamer.running else 'Resume' }} monitoring</button>
{% if streamer_has_error %}<div hx-swap-oob="beforeend:#content"><div class="error-modal" role="alert"><span>{{ streamer_error_message }}</span><button type="button" data-action="dismiss-error">Dismiss</button></div></div>{% endif %}
